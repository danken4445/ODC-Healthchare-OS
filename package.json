{
  "name": "odyssey-healthcare-os",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test:e2e": "playwright test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "db:types": "supabase gen types typescript --local > packages/types/src/database.ts",
    "desktop:admin:dev": "pnpm --filter @odyssey/desktop-admin dev",
    "desktop:admin:build": "pnpm --filter @odyssey/desktop-admin build:win",
    "desktop:admin:build:mac": "pnpm --filter @odyssey/desktop-admin build:mac",
    "desktop:provider:dev": "pnpm --filter @odyssey/desktop-provider dev",
    "desktop:provider:build": "pnpm --filter @odyssey/desktop-provider build:win",
    "desktop:provider:build:mac": "pnpm --filter @odyssey/desktop-provider build:mac"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.62.1",
    "@supabase/supabase-js": "^2.49.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.4.2",
    "supabase": "^1.226.4",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
