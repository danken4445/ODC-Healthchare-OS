# Public, safe-to-expose browser values from the Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public DSN for browser error reporting. Do not set this until the matching
# Sentry project has been created; it is intentionally safe to expose.
NEXT_PUBLIC_SENTRY_DSN=https://public-key@example.ingest.sentry.io/project-id
